{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "node scripts/clean-next.cjs",
    "open-all": "node scripts/open-all-files.js",
    "openall": "npm run open-all",
    "predev": "npm run clean:next",
    "dev": "next dev --webpack",
    "prebuild": "npm run clean:next",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components hooks lib proxy.ts i18n.ts next.config.js",
    "eslint": "npm run lint",
    "eslint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test:public": "node scripts/verify-public-rendering.mjs",
    "test": "node scripts/run-tests.cjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:public",
    "typegen": "node scripts/typegen.cjs",
    "backend-snapshot": "node scripts/backend-snapshot.js",
    "snapshot": "node scripts/backend-snapshot.js",
    "gen:rpc": "node scripts/gen-rpc-definitions.mjs",
    "gen:edge-functions": "node scripts/gen-edge-functions.mjs",
    "gen:policies": "node scripts/gen-policies.mjs",
    "rpcmap": "node scripts/gen-rpc-map.mjs",
    "funcgen": "node scripts/gen-functions-sql.cjs",
    "fulldb": "npm run typegen && npm run backend-snapshot -- --reuse-types && npm run gen:rpc && npm run gen:edge-functions && npm run gen:policies && npm run rpcmap && npm run funcgen",
    "audit:supabase": "node scripts/supabase_audit.mjs --in audits/supabase --out audits/supabase/supabase_audit.md --top 20 --format both",
    "audit:supabase:security": "node scripts/supabase_audit.mjs --in audits/supabase --out audits/supabase/supabase_audit.md --only security --top 20 --format both",
    "audit:supabase:perf": "node scripts/supabase_audit.mjs --in audits/supabase --out audits/supabase/supabase_audit.md --only performance --top 20 --format both",
    "audit:supabase:queries": "node scripts/supabase_audit.mjs --in audits/supabase --out audits/supabase/supabase_audit.md --only queries --top 20 --format both",
    "audit:supabase:collect": "node scripts/supabase_collect.mjs",
    "log5": "node scripts/supabase_logs.mjs",
    "log5:invite": "node scripts/supabase_logs.mjs --invite",
    "log5:error": "node scripts/supabase_logs.mjs --severity=error",
    "log5:full": "node scripts/supabase_logs.mjs --severity=all",
    "log5:postgres": "node scripts/supabase_logs.mjs postgres_logs",
    "log5:setup": "node scripts/setup_supabase_logs.mjs",
    "supabaselogs": "node scripts/supabase_logs.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@supabase/supabase-js": "^2.87.3",
    "@tiptap/extension-color": "^3.13.0",
    "@tiptap/extension-text-style": "^3.13.0",
    "@tiptap/html": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "^2.15.4"
  },
  "overrides": {
    "recharts": {
      "react-is": "$react-is"
    },
    "eslint-config-next": {
      "@next/eslint-plugin-next": {
        "fast-glob": "3.3.3"
      }
    }
  },
  "devDependencies": {
    "@types/node": "20.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "baseline-browser-mapping": "^2.9.7",
    "commander": "^14.0.3",
    "dotenv": "^17.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "find-up": "^8.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.2",
    "tsx": "^4.20.5",
    "typescript": "5.2.2",
    "zod": "^4.3.6"
  }
}
